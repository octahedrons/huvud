#!/bin/bash

# echo commands
set -x

# install app dependencies
bundle install

# install overman if not installed
command -v overman >/dev/null 2>&1 || gem install --no-document overman

# start app and wait for it
overman start &
sleep 3

# run the test and save the result
curl --silent --fail http://localhost:${PORT:-5000}/
test_result=$?

if [ "$test_result" -eq 0 ]; then
  curl --silent --fail http://localhost:${PORT:-5000}/json |
    ruby -rjson -e '
      body = STDIN.read
      value = JSON.parse(body)
      abort "expected /json to return an object" unless value.is_a?(Hash)
      abort "expected /json to be pretty printed" unless body.start_with?("{\n  ")
    '
  test_result=$?
fi

# stop app
kill $!
wait $!

exit $test_result
